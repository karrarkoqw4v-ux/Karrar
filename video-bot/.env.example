# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC...
# آيدي الأدمن (أكثر من واحد مفصولين بفاصلة) — لأوامر /stats /addch /delch /bcast
ADMIN_IDS=
# قنوات الاشتراك الإجباري الابتدائية (اختياري). مثال: @channel1,@channel2
# يجب أن يكون البوت مشرفاً (Admin) في كل قناة
FORCE_CHANNELS=
# عدد التحميلات المتزامنة
MAX_PARALLEL=8
# أقصى مدة فيديو بالثواني
MAX_DURATION=3600
# ملف كوكيز (صيغة Netscape) لتجاوز حظر يوتيوب/انستغرام عند الحاجة
COOKIES_FILE=
# بروكسي اختياري
PROXY=
# عنوان Bot API المحلي لرفع حتى 2GB (اختياري). مثال: http://localhost:8081
TELEGRAM_API_URL=
