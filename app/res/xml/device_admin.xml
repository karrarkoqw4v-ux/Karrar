<?xml version="1.0" encoding="utf-8"?>
<!-- Real, limited device-admin policies this app can use once the user activates it from Android's own
     system screen. Device Admin does NOT and cannot grant control of other apps (that needs Accessibility
     Service, which this app never requests). -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <limit-password />
        <disable-camera />
    </uses-policies>
</device-admin>
