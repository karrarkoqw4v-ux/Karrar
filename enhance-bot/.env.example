# توكن البوت من BotFather
BOT_TOKEN=
# آيدي حسابك للأدمن (/stats و /bcast). أرسل /id للبوت لتعرفه
ADMIN_IDS=8010837412
# رابط HTTPS العام للاستضافة (يفعّل محرر النصوص كتطبيق مصغّر). مثال: https://my-bot.onrender.com
WEBAPP_URL=
# أقصى مدة للفيديو بالثواني
MAX_DURATION=7200
# عدد المعالجات المتزامنة
MAX_PARALLEL=2
# 1 = إيموجيات مميزة (Premium) في النصوص والأزرار — تتطلب أن يكون مالك البوت مشتركاً في تيليجرام بريميوم
PREMIUM_EMOJI=1
# مسار ملف كوكيز إنستغرام (اختياري: للمحتوى الخاص/المقيّد)
IG_COOKIES=

# 0 = لا ترسل للمسؤول رسالة «البوت اشتغل» مع زر اتصال بكلاود
ANNOUNCE_START=1

# مراقبة 24/7: ثواني تجمّد الحلقة قبل إعادة التشغيل الذاتي، وحد الذاكرة (MB) لإعادة التشغيل الاحترازية (0 = معطّل)
WATCHDOG_STALL=45
MAX_RSS_MB=0
