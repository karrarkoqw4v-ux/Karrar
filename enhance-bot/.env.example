# توكن البوت من BotFather
BOT_TOKEN=
# آيدي حسابك للأدمن (/stats و /bcast). أرسل /id للبوت لتعرفه
ADMIN_IDS=8010837412
# رابط HTTPS العام للاستضافة (يفعّل محرر النصوص كتطبيق مصغّر). مثال: https://my-bot.onrender.com
WEBAPP_URL=
# أقصى مدة للفيديو بالثواني
MAX_DURATION=7200
# عدد المعالجات المتزامنة
MAX_PARALLEL=2
# 1 = إيموجيات مميزة (Premium) في النصوص والأزرار — تتطلب أن يكون مالك البوت مشتركاً في تيليجرام بريميوم
PREMIUM_EMOJI=1
